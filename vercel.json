{
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "buildCommand": "python manage.py migrate && python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
